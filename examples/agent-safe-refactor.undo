# An agent can plan this change, present it for approval, then run it with --yes.
transaction "refactor-layout" {
  require is_dir "internal/legacy"
  mkdir "internal/platform"
  move "internal/legacy/paths.go" -> "internal/platform/paths.go"
  write "REFACTOR_STATUS" = "platform layout complete"
  assert is_file "internal/platform/paths.go"
  assert not_exists "internal/legacy/paths.go"
}

